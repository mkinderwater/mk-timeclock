[Unit]
Description=mk-timeclock Slave Adoption Setup
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /opt/icubedev-timeclock/bin/clock-setup.py
Restart=on-failure
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/etc/timeclock
[Install]
WantedBy=multi-user.target

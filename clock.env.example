# Install a remote Slave with ./install-slave.sh.
# Install the authoritative Primary with ./install-master.sh.
# Remote clocks must point to the authoritative server through trusted HTTPS.
# DEVICE_KEY is unique for this CLOCK_ID; provision it on the primary.
# Reference only: install.sh generates /etc/timeclock/timeclock.env with real keys.
# Values are read literally (no $ expansion); quotes are optional and not required.
TIMECLOCK_ROLE=slave
ATTENDANCE_ENABLED=yes
CLOCK_ID=CLOCK-002
SERVER_URL=https://timeclock.example.org
DEVICE_KEY=CHANGE_ME_LONG_DEVICE_KEY
SPI_DEV=/dev/spidev0.0
GPIOCHIP=/dev/gpiochip0
# BPI-M2 Zero header physical pin 7 = PA6 = gpiochip0 line offset 6 on the supported image.
# Physical pin 6 is GND. Requires 3.3V-compatible active buzzer or driver transistor.
BUZZER_OFFSET=6
I2C_DEV=/dev/i2c-0
TTF_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf
I2C_ADDR=0x3c

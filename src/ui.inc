#define UI_JS "<script>window.tc=(function(){function mark(el,cls,m){if(!el)return;el.textContent=m;el.classList.remove('is-err','is-ok');if(m){el.classList.add(cls);el.dataset.flagText=el.textContent;}else delete el.dataset.flagText;}new MutationObserver(function(list){list.forEach(function(r){var el=r.target.nodeType===1?r.target:r.target.parentElement;if(el&&el.dataset&&el.dataset.flagText!==undefined&&el.textContent!==el.dataset.flagText){el.classList.remove('is-err','is-ok');delete el.dataset.flagText;}});}).observe(document.documentElement,{childList:true,characterData:true,subtree:true});function flag(t,l){var s=document.createElement('span');s.className='flag flag-'+l;s.textContent=t;return s;}function banner(el,l,label,t){if(!el)return;el.replaceChildren();el.hidden=!t;if(!t)return;el.className='banner banner-'+l;var x=document.createElement('span');x.textContent=t;el.append(flag(label,l),x);}function ago(s){s=Math.max(0,Math.floor(Number(s)||0));return s<120?s+'s':s<7200?Math.floor(s/60)+'m':s<172800?Math.floor(s/3600)+'h':Math.floor(s/86400)+'d';}function text(e){return e&&e.message!==undefined?e.message:String(e);}function timeoutError(){return Error('The clock took too long to respond. Check the result before trying again.');}async function request(url,options){var c=new AbortController(),timedOut=false,timer,rejectDeadline,parent=options&&options.signal;if(parent&&parent.aborted)throw parent.reason||Error('Request cancelled.');var deadline=new Promise(function(resolve,reject){rejectDeadline=reject;timer=setTimeout(function(){timedOut=true;c.abort();reject(timeoutError());},15000);});function cancel(){c.abort();rejectDeadline(parent.reason||Error('Request cancelled.'));}if(parent)parent.addEventListener('abort',cancel,{once:true});try{return await Promise.race([(async function(){var r=await fetch(url,{...options,signal:c.signal});await r.clone().arrayBuffer();return r;})(),deadline]);}catch(e){if(timedOut)throw timeoutError();throw e;}finally{clearTimeout(timer);if(parent)parent.removeEventListener('abort',cancel);}}async function api(url,options){var r=await request(url,{...options,cache:'no-store'}),j=await window.tc.json(r);if(!r.ok)throw Error(j.error||'Request failed');return j;}function health(k,v){var n=Number(v),has=v!==null&&v!==undefined&&v!==''&&Number.isFinite(n);if(k==='temperature_millicelsius')return has&&n>=80000?['problem','Too hot']:has&&n>=70000?['check','Hot']:null;if(k==='storage_available_bytes')return has&&n<268435456?['problem','Nearly full']:has&&n<1073741824?['check','Low']:null;if(k==='wifi_connected')return v?null:['problem','No network'];if(k==='wifi_signal_bars')return has&&n<=1?['check','Weak']:null;if(k==='failed_email')return has&&n>0?['problem','See Email queue']:null;if(k==='queued_email')return has&&n>20?['check','Backlog']:null;if(k==='ntp_indicator')return v==='Synchronized'?null:['problem','Punches refused'];return null;}return{json:async function(r){var t=await r.text(),j;try{j=JSON.parse(t);}catch(e){throw Error('The clock could not complete this. Try again.');}if(!j||typeof j!=='object')throw Error('The clock could not complete this. Try again.');return j;},err:function(el,e){mark(el,'is-err',text(e));},ok:function(el,m){mark(el,'is-ok',m);},request:request,api:api,flag:flag,banner:banner,ago:ago,health:health,time:function(s){var d=new Date(s);return isNaN(d.getTime())?String(s):d.toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'});},datetime:function(s){var d=new Date(s);if(isNaN(d.getTime()))return String(s);return d.toLocaleString('en-CA',{weekday:'short',month:'short',day:'numeric',year:'numeric',hour:'numeric',minute:'2-digit',timeZoneName:'short',hour12:true}).replace('a.m.','AM').replace('p.m.','PM');},CARD:'Tap your manager card on the clock within 30 seconds.',TIMEOUT:'Time ran out. Try again.'};})();</script>"

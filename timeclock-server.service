[Unit]
Description=mk-timeclock Web and SQLite Backend
After=network.target
[Service]
Type=simple
User=timeclock
Group=timeclock
SupplementaryGroups=systemd-journal
WorkingDirectory=/var/lib/timeclock
ExecStart=/opt/icubedev-timeclock/bin/run-server.sh
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/timeclock
[Install]
WantedBy=multi-user.target
